{
  "name": "@christian-wechsel/logger",
  "version": "0.1.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "clean": "./bin/clean.sh",
    "prebuild": "npm run clean",
    "build": "tsc --project tsconfig.json",
    "prebuild-test": "npm run clean",
    "build-test": "tsc --project tsconfig.test.json",
    "prebuild-prod": "npm run clean",
    "build-prod": "tsc --project tsconfig.prod.json",
    "prepublishOnly": "npm run build-prod",
    "test:unit": "set NODE_ENV=test && npm run build-test && jest --selectProjects Unit",
    "test:int": "set NODE_ENV=test && npm run build-test && jest --selectProjects Integration",
    "test": "npm run build-test && jest",
    "debug": "node --inspect-brk dist/index.js",
    "start": "node dist/index.js"
  },
  "keywords": [],
  "homepage": "https://github.com/ChristianWechsel/logger#readme",
  "bugs": {
    "url": "https://github.com/ChristianWechsel/logger/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChristianWechsel/logger.git"
  },
  "author": "Christian Wechsel <npm@christian-wechsel.com>",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "types": "dist/index.d.ts",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "jest": "^30.5.2",
    "typescript": "^7.0.2"
  }
}
